{
  "version": 1,
  "author": "IoT PBL - Smart Greenhouse",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },

    { "type": "wokwi-dht22", "id": "dht1", "top": -100, "left": 230, "attrs": { "temperature": "28", "humidity": "60" } },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": -110, "left": 330, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled1", "top": -150, "left": -200, "attrs": { "i2cAddress": "0x3c" } },

    { "type": "wokwi-relay-module", "id": "relay1", "top": 60, "left": 300, "attrs": {} },
    { "type": "wokwi-resistor", "id": "r1", "top": 150, "left": 410, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led1", "top": 130, "left": 480, "attrs": { "color": "green", "label": "FAN" } },

    { "type": "wokwi-relay-module", "id": "relay2", "top": 190, "left": 300, "attrs": {} },
    { "type": "wokwi-resistor", "id": "r2", "top": 280, "left": 410, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led2", "top": 260, "left": 480, "attrs": { "color": "blue", "label": "PUMP" } },

    { "type": "wokwi-buzzer", "id": "bz1", "top": 340, "left": 230, "attrs": { "volume": "0.1" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "dht1:VCC", "esp:3V3", "red", [] ],
    [ "dht1:GND", "esp:GND.1", "black", [] ],
    [ "dht1:SDA", "esp:D15", "green", [] ],

    [ "pot1:VCC", "esp:3V3", "red", [] ],
    [ "pot1:GND", "esp:GND.1", "black", [] ],
    [ "pot1:SIG", "esp:D34", "orange", [] ],

    [ "oled1:VCC", "esp:3V3", "red", [] ],
    [ "oled1:GND", "esp:GND.1", "black", [] ],
    [ "oled1:SDA", "esp:D21", "blue", [] ],
    [ "oled1:SCL", "esp:D22", "purple", [] ],

    [ "relay1:VCC", "esp:VIN", "red", [] ],
    [ "relay1:GND", "esp:GND.2", "black", [] ],
    [ "relay1:IN", "esp:D26", "green", [] ],
    [ "relay1:COM", "esp:3V3", "red", [] ],
    [ "relay1:NO", "r1:1", "yellow", [] ],
    [ "r1:2", "led1:A", "yellow", [] ],
    [ "led1:C", "esp:GND.2", "black", [] ],

    [ "relay2:VCC", "esp:VIN", "red", [] ],
    [ "relay2:GND", "esp:GND.2", "black", [] ],
    [ "relay2:IN", "esp:D27", "cyan", [] ],
    [ "relay2:COM", "esp:3V3", "red", [] ],
    [ "relay2:NO", "r2:1", "yellow", [] ],
    [ "r2:2", "led2:A", "yellow", [] ],
    [ "led2:C", "esp:GND.2", "black", [] ],

    [ "bz1:1", "esp:GND.2", "black", [] ],
    [ "bz1:2", "esp:D25", "magenta", [] ]
  ],
  "dependencies": {}
